{
  "name": "tandem",
  "private": true,
  "version": "0.2.7",
  "type": "module",
  "description": "A tool for one person and an AI to build a project together: started in a project's folder, it gives both the same commands.",
  "scripts": {
    "start": "node --no-warnings core/start.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "release": "node --no-warnings desktop/release.ts",
    "icon": "node --no-warnings desktop/icon.ts",
    "test": "node --no-warnings --test \"art/test/*.test.js\" && node --no-warnings --test --test-force-exit --test-concurrency=1 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "lucide": "^1.73.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@types/three": "^0.170.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  },
  "bin": {
    "tandem": "bin/tandem"
  }
}
