{
  "name": "tandem",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A tool for one person and an AI to build a project together: started in a project's folder, it gives both the same commands.",
  "scripts": {
    "start": "node --no-warnings core/start.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "node --no-warnings --test \"art/test/*.test.js\" && node --no-warnings --test --test-force-exit --test-concurrency=2 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "archetype-ecs": "file:../archetype-ecs"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  },
  "bin": {
    "tandem": "bin/tandem"
  }
}
